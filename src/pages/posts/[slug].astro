---
/** A single post: date block, title, tags, cover, text, then older/newer links. */
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import PostDate from '@/components/PostDate.astro';
import LinkCard from '@/components/LinkCard.astro';
import Prose from '@/components/Prose.astro';
import Sidebar from '@/components/Sidebar.astro';
import TagList from '@/components/TagList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { shortDate } from '@/lib/format';
import { shared } from '@/lib/motion';
import { displayTitle, getPosts, postUrl, summary, type Post } from '@/lib/posts';
import { breadcrumbSchema, postSchema } from '@/lib/seo';
import { SITE } from '@/site.config';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, cover, coverAlt, tags, date, updated, link, linkTitle } = post.data;
const { Content } = await render(post);
const heading = displayTitle(post);

// The same 1200×630 crop BaseHead uses for link previews.
const socialImage = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src
  : SITE.socialImage;
const schema = [
  postSchema(post, new URL(socialImage, Astro.site).href),
  breadcrumbSchema([
    [SITE.title, '/'],
    [heading, postUrl(post)],
  ]),
];
---

<BaseLayout
  title={heading}
  description={summary(post)}
  image={cover ?? SITE.socialImage}
  imageAlt={coverAlt}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
  schema={schema}
>
  <article class="article" data-pagefind-body data-pagefind-meta={`date:${shortDate(date)}`}>
    <div data-pagefind-ignore transition:name={shared.date(post.id)}><PostDate date={date} /></div>
    <div class="body">
      <header class="head" data-feather>
        {/* Only a real title flies; a note's hidden heading must not get a name. */}
        {
          title ? (
            <h1 class="title" data-pagefind-meta="title" transition:name={shared.title(post.id)}>
              {heading}
            </h1>
          ) : (
            <h1 class="title visually-hidden" data-pagefind-meta="title">
              {heading}
            </h1>
          )
        }
        {
          updated && (
            <p class="updated" data-pagefind-ignore>
              updated <time datetime={updated.toISOString()}>{shortDate(updated)}</time>
            </p>
          )
        }
        <div data-pagefind-ignore><TagList tags={tags} /></div>
      </header>
      {
        cover && (
          <div class="cover" transition:name={shared.cover(post.id)}>
            <Image src={cover} alt={coverAlt ?? ''} width={1200} loading="eager" />
          </div>
        )
      }
      <Prose><Content /></Prose>
      {
        link && (
          <div class="feather" style="--i: 2">
            <LinkCard url={link} title={linkTitle} />
          </div>
        )
      }

      <nav class="pager feather" style="--i: 3" aria-label="More posts" data-pagefind-ignore>
        {
          older && (
            <a class="older" href={postUrl(older)}>
              <span class="label">← older · {shortDate(older.data.date)}</span>
              <span class="name">{displayTitle(older)}</span>
            </a>
          )
        }
        {
          newer && (
            <a class="newer" href={postUrl(newer)}>
              <span class="label">newer · {shortDate(newer.data.date)} →</span>
              <span class="name">{displayTitle(newer)}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>
  <Sidebar slot="sidebar" />
</BaseLayout>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    margin-block-start: var(--space-xs);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .title {
    view-transition-class: text;
    font-size: var(--text-article-title);
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .updated {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .cover {
    overflow: hidden;
    background: var(--color-tile);
    view-transition-class: cover;
  }

  .cover :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-m);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-l);
    border-top: var(--border-thin);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .pager a:hover {
    text-decoration: none;
  }

  .pager a:hover .name {
    text-decoration: underline;
  }

  .newer {
    grid-column: -2;
    text-align: end;
  }

  .label {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .name {
    font-size: var(--text-l);
    font-weight: var(--weight-bold);
    line-height: 1.35;
  }

  @media (width >= 48rem) {
    .article {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
    }

    .body {
      margin: 0;
      padding-inline-start: var(--space-l);
      border-left: var(--border-thin);
    }

    .head {
      gap: var(--space-s);
    }
  }
</style>
