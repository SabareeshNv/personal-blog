---
/**
 * Search, powered by Pagefind. `npm run build` indexes every post into
 * dist/pagefind/; the script below loads that index in the browser.
 * The search index only exists after a build, so search does not work in
 * `npm run dev`; use `npm run build && npm run preview` to try it.
 */
import PageIntro from '@/components/PageIntro.astro';
import SearchBox from '@/components/SearchBox.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search the posts on Lone Voice.">
  <PageIntro title="search" />
  <div class="box">
    <SearchBox size="large" showLabel={false} id="search-page-field" />
  </div>

  <p class="status" role="status" aria-live="polite" data-status></p>
  <ol class="results" data-results></ol>

  <template data-result-template>
    <li class="result feather">
      <a class="link">
        <span class="date" data-date></span>
        <span class="title" data-title></span>
        <p class="excerpt" data-excerpt></p>
      </a>
    </li>
  </template>
</BaseLayout>

<script>
  interface PagefindData {
    url: string;
    excerpt: string;
    meta: { title?: string; date?: string };
  }
  interface Pagefind {
    search: (query: string) => Promise<{ results: { data: () => Promise<PagefindData> }[] }>;
  }

  const MAX_RESULTS = 20;
  let pagefind: Pagefind | undefined;

  async function loadPagefind(): Promise<Pagefind | undefined> {
    try {
      // The index is generated at build time, so Vite must not bundle it.
      pagefind ??= (await import(/* @vite-ignore */ `${location.origin}/pagefind/pagefind.js`)) as Pagefind;
      return pagefind;
    } catch {
      return undefined;
    }
  }

  /**
   * Runs on every visit to the search page. With Astro's client router a
   * page script only loads once, so the setup listens for `astro:page-load`.
   */
  function setUpSearch() {
    const input = document.querySelector<HTMLInputElement>('#search-page-field');
    if (!input?.form) return; // not on the search page

    const form = input.form;
    const status = document.querySelector<HTMLElement>('[data-status]')!;
    const list = document.querySelector<HTMLOListElement>('[data-results]')!;
    const template = document.querySelector<HTMLTemplateElement>('[data-result-template]')!;

    function renderResult(data: PagefindData, index: number) {
      const item = template.content.cloneNode(true) as DocumentFragment;
      item.querySelector<HTMLElement>('li')!.style.setProperty('--i', String(index));
      item.querySelector<HTMLAnchorElement>('a')!.href = data.url;
      item.querySelector('[data-date]')!.textContent = data.meta.date ?? '';
      item.querySelector('[data-title]')!.textContent = data.meta.title ?? data.url;
      // Pagefind returns the excerpt as HTML with <mark> around the matches.
      item.querySelector('[data-excerpt]')!.innerHTML = data.excerpt;
      return item;
    }

    async function runSearch(query: string) {
      list.replaceChildren();
      if (!query) {
        status.textContent = '';
        return;
      }
      const engine = await loadPagefind();
      if (!engine) {
        status.textContent = 'Search is not available here. It works on the built site.';
        return;
      }
      status.textContent = 'Searching…';
      const { results } = await engine.search(query);
      const data = await Promise.all(results.slice(0, MAX_RESULTS).map((result) => result.data()));
      list.replaceChildren(...data.map(renderResult));
      const count = results.length;
      status.textContent = `${count} ${count === 1 ? 'result' : 'results'} for “${query}”`;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      history.replaceState(history.state, '', url);
      runSearch(query);
    });

    const initial = new URLSearchParams(location.search).get('q')?.trim() ?? '';
    input.value = initial;
    if (initial) runSearch(initial);
    else input.focus();
  }

  document.addEventListener('astro:page-load', setUpSearch);
</script>

<style>
  .box {
    margin-block-start: var(--space-m);
  }

  .status {
    margin-block-start: var(--space-s);
    font-size: var(--text-s);
    color: var(--color-muted);
  }

  .status:empty {
    display: none;
  }

  .results {
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .results:not(:empty) {
    border-top: var(--border-thin);
  }

  .result {
    border-bottom: var(--border-thin);
  }

  .link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-block: var(--space-m);
  }

  .link:hover {
    text-decoration: none;
  }

  .link:hover .title {
    text-decoration: underline;
  }

  .date {
    font-size: var(--text-2xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    line-height: 1.3;
  }

  .excerpt {
    font-size: var(--text-s);
    color: var(--color-body);
  }

  .excerpt :global(mark) {
    background: transparent;
    color: var(--color-accent-text);
    font-weight: var(--weight-bold);
  }

  @media (width >= 48rem) {
    .box {
      margin-block-start: var(--space-xl);
    }

    .status {
      margin-block-start: var(--space-m);
    }

    .title {
      font-size: 1.375rem;
    }

    .excerpt {
      font-size: var(--text-l);
    }
  }
</style>
