---
/** Homepage: every post, newest first, ten to a page. */
import type { GetStaticPaths, Page } from 'astro';
import Pagination from '@/components/Pagination.astro';
import Sidebar from '@/components/Sidebar.astro';
import Timeline from '@/components/Timeline.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, type Post } from '@/lib/posts';
import { websiteSchema } from '@/lib/seo';
import { SITE } from '@/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: SITE.pageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const first = page.currentPage === 1;
const title = first ? undefined : `Page ${page.currentPage} of ${page.lastPage}`;
const description = first ? SITE.description : `Older posts on ${SITE.title}, page ${page.currentPage}.`;
---

<BaseLayout title={title} description={description} header="home" schema={first ? [websiteSchema()] : []}>
  <h2 class="visually-hidden">Latest posts</h2>
  <Timeline posts={page.data} />
  <Pagination page={page} />
  <Sidebar slot="sidebar" showIntro={page.currentPage === 1} />
</BaseLayout>
