---
/**
 * The shell of every page: <head>, skip link, header, main and footer.
 *
 * Content goes in the default slot. Pass a `sidebar` slot to get the
 * two-column layout on large screens; without it the page is one column.
 */
import BaseHead from '@/components/BaseHead.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { pageTurn, sideTurn } from '@/lib/motion';
import { SITE } from '@/site.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  header?: 'home' | 'page';
}

const { title, description, image, type, header = 'page' } = Astro.props;
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SiteHeader variant={header} search={hasSidebar ? 'mobile' : 'always'} />
    <div class:list={['container', 'layout', { 'with-sidebar': hasSidebar }]}>
      <main id="content" class="main" transition:name="main" transition:animate={pageTurn}>
        <slot />
      </main>
      {
        hasSidebar && (
          <aside class="sidebar" aria-label={`More from ${SITE.title}`} transition:name="sidebar" transition:animate={sideTurn}>
            <slot name="sidebar" />
          </aside>
        )
      }
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2xs);
    left: var(--space-2xs);
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--color-accent);
    color: var(--color-on-accent);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .layout {
    padding-block-start: var(--space-header);
  }

  .main {
    min-width: 0;
    max-width: var(--width-main);
  }

  /* Phones and tablets: the sidebar follows the main content. */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-block-start: var(--space-2xl);
  }

  @media (width >= 64rem) {
    .with-sidebar {
      display: grid;
      grid-template-columns: minmax(0, var(--width-main)) var(--width-side);
      justify-content: space-between;
      gap: var(--gap-columns);
      align-items: start;
    }

    .sidebar {
      position: sticky;
      top: var(--space-l);
      margin-block-start: 0;
    }
  }
</style>
