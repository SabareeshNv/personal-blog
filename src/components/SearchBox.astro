---
/**
 * A search field that sends the query to /search/, where Pagefind runs.
 * Works without JavaScript: it is a plain GET form.
 */
import Icon from './Icon.astro';

interface Props {
  /** `large` is the field at the top of the search page. */
  size?: 'normal' | 'large';
  value?: string;
  /** Show “search” as a visible heading above the field. */
  showLabel?: boolean;
  id?: string;
}

const { size = 'normal', value, showLabel = true, id = 'site-search' } = Astro.props;
---

<search>
  <form class:list={['search', size]} action="/search/" method="get" role="search">
    <label for={id} class:list={[showLabel ? 'label' : 'visually-hidden']}>search</label>
    <div class="field">
      <input id={id} type="search" name="q" placeholder="search posts" value={value} autocomplete="off" />
      <button type="submit" aria-label="Search">
        <Icon name="search" size={size === 'large' ? 22 : 20} />
      </button>
    </div>
  </form>
</search>

<style>
  .label {
    display: block;
    margin-block-end: var(--space-s);
    font-size: var(--text-side-heading);
    font-weight: var(--weight-light);
    line-height: var(--leading-tight);
  }

  .field {
    display: flex;
    border: 2px solid var(--color-muted);
    background: var(--color-bg);
  }

  .large .field {
    border-color: var(--color-fg);
  }

  .field:focus-within {
    border-color: var(--color-accent-text);
  }

  input {
    flex: 1;
    min-width: 0;
    height: 3rem;
    padding-inline: var(--space-s);
    border: 0;
    background: transparent;
    font-size: var(--text-l);
  }

  input:focus {
    outline: none;
  }

  input::placeholder {
    color: var(--color-muted);
  }

  .large input {
    height: 3.5rem;
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
  }

  button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    border: 0;
    background: var(--color-accent);
    color: var(--color-on-accent);
    cursor: pointer;
  }

  @media (width >= 48rem) {
    .large input {
      height: 4rem;
      padding-inline: var(--space-m);
      font-size: 1.375rem;
    }

    .large button {
      width: 4.25rem;
    }
  }
</style>
