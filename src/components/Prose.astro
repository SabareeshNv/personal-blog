---
/**
 * Typography for long-form text: post bodies, About and the policies.
 * Styles reach rendered Markdown through :global(), scoped to this wrapper.
 */
---

<div class="prose"><slot /></div>

<style>
  .prose {
    font-size: var(--text-l);
    line-height: var(--leading-loose);
    color: var(--color-body);
  }

  .prose > :global(* + *) {
    margin-block-start: var(--space-m);
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin-block-start: var(--space-xl);
    color: var(--color-fg);
    font-weight: var(--weight-bold);
    line-height: 1.25;
  }

  .prose :global(h2) {
    font-size: 1.3125rem;
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
  }

  .prose :global(:is(h2, h3) + *) {
    margin-block-start: var(--space-s);
  }

  /* Plain Markdown links only, not components such as the round buttons. */
  .prose :global(a:not([class])) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(strong) {
    color: var(--color-fg);
    font-weight: var(--weight-bold);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-m);
  }

  .prose :global(li + li) {
    margin-block-start: var(--space-2xs);
  }

  /* Quotations: large and thin, with an accent quote mark. */
  .prose :global(blockquote) {
    margin-block: var(--space-xl);
    font-size: var(--text-2xl);
    font-weight: var(--weight-light);
    line-height: 1.45;
    color: var(--color-fg);
  }

  .prose :global(blockquote::before) {
    content: '“';
    display: block;
    font-size: 4rem;
    line-height: 0.6;
    color: var(--color-accent-text);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background: var(--color-tile);
  }

  .prose :global(pre) {
    padding: var(--space-s);
    overflow-x: auto;
    background: var(--color-tile) !important;
    font-size: var(--text-s);
    line-height: var(--leading-normal);
  }

  .prose :global(img) {
    width: 100%;
  }

  .prose :global(figcaption) {
    margin-block-start: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .prose :global(hr) {
    border: 0;
    border-top: var(--border-thin);
  }

  @media (width >= 48rem) {
    .prose {
      font-size: 1.125rem;
    }

    .prose :global(h2) {
      font-size: 1.625rem;
    }

    .prose :global(blockquote) {
      font-size: 1.625rem;
    }

    .prose :global(pre) {
      padding: var(--space-m);
    }
  }
</style>
