---
/**
 * Decides how each page change moves, Windows Phone style:
 *
 * - Pivot: between the menu sections (posts, topics, archive, about) the
 *   content slides sideways, in the direction of the menu.
 * - Turnstile: anywhere else, the visible items swing away one by one on
 *   their left-edge hinge, then the new page's items feather in.
 * - Continuum: a post's date, title and cover fly between the timeline and
 *   the post page, but only when the other page really shows the same post.
 *   Anything without a partner swings away or feathers in like the rest,
 *   instead of hanging in place and fading.
 *
 * The choice is written to <html data-motion="…"> for src/styles/motion.css.
 */
---

<script>
  import { EXIT, LIFT, motionFor, shared } from '@/lib/motion';

  type Part = keyof typeof shared;

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const POST_PATH = /^\/posts\/([^/]+)\/?$/;
  const postIdOf = (url: URL) => url.pathname.match(POST_PATH)?.[1];

  /* ---------- Names ---------- */

  /** The flight name of an element: a post page's `data-flight`, or a named card part. */
  function flightName(el: HTMLElement): string | undefined {
    if (el.dataset.flight) return el.dataset.flight;
    const name = el.style.viewTransitionName;
    return name && name !== 'none' ? name : undefined;
  }

  /** Card parts for post `id` in `doc`, with the names they would fly under. */
  function cardParts(doc: Document, id: string) {
    const card = doc.querySelector<HTMLElement>(`[data-post-id="${CSS.escape(id)}"]`);
    const parts = [...(card?.querySelectorAll<HTMLElement>('[data-continuum]') ?? [])];
    return { card, parts: parts.map((el) => ({ el, name: shared[el.dataset.continuum as Part](id) })) };
  }

  /** Give the card for post `id` its flight names (only the card involved flies). */
  function nameCard(doc: Document, id: string, allowed?: Set<string>) {
    const { card, parts } = cardParts(doc, id);
    if (!card) return;
    let named = 0;
    for (const { el, name } of parts) {
      if (allowed && !allowed.has(name)) continue;
      el.style.viewTransitionName = name;
      named++;
    }
    if (named) card.classList.add('flying'); // flies; doesn't also feather in
  }

  function clearCardNames(doc: Document) {
    doc.querySelectorAll<HTMLElement>('[data-continuum]').forEach((el) => (el.style.viewTransitionName = ''));
  }

  /** Elements on this page that could fly (named post pieces). */
  const flightCandidates = () =>
    [...document.querySelectorAll<HTMLElement>('main [data-flight], main [data-continuum]')].filter((el) => flightName(el));

  /** Names the incoming page offers as landing spots. */
  function landingNames(newDoc: Document, from: URL): Set<string> {
    const names = new Set([...newDoc.querySelectorAll<HTMLElement>('[data-flight]')].map((el) => el.dataset.flight!));
    const id = postIdOf(from);
    if (id) cardParts(newDoc, id).parts.forEach(({ name }) => names.add(name));
    return names;
  }

  /* ---------- Turnstile exit ---------- */

  const ITEMS = 'main .feather, main [data-feather] > *';

  function isOnScreen(el: Element) {
    const box = el.getBoundingClientRect();
    return box.height > 0 && box.bottom > 0 && box.top < innerHeight;
  }

  /** Swing elements away on their left-edge hinge, top first. */
  function swingAway(elements: HTMLElement[], back: boolean, startIndex = 0) {
    const angle = back ? EXIT.angle : -EXIT.angle;
    return elements
      .filter(isOnScreen)
      .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)
      .map((el, i) => {
        el.style.transformOrigin = '0 50%';
        return el.animate(
          [
            { transform: 'perspective(800px) rotateY(0deg)', opacity: 1 },
            { transform: `perspective(800px) rotateY(${angle}deg)`, opacity: 0 },
          ],
          {
            duration: EXIT.duration,
            delay: Math.min(startIndex + i, EXIT.maxStagger) * EXIT.stagger,
            easing: EXIT.easing,
            fill: 'forwards',
          },
        ).finished;
      });
  }

  const lift = (elements: HTMLElement[]) =>
    elements.map(
      (el) =>
        el.animate([{ transform: 'none' }, { transform: LIFT.transform }], {
          duration: LIFT.duration,
          easing: LIFT.easing,
          fill: 'forwards',
        }).finished,
    );

  /* ---------- Wiring ---------- */

  document.addEventListener('astro:before-preparation', (event) => {
    const motion = motionFor(event.from, event.to);
    document.documentElement.dataset.motion = motion;

    // Opening a post from a list: its card is the only one that may fly.
    clearCardNames(document);
    const toId = postIdOf(event.to);
    if (toId) nameCard(document, toId);

    if (motion !== 'turnstile' || reducedMotion.matches) return;

    const back = event.direction === 'back';
    const candidates = flightCandidates();
    const load = event.loader;

    event.loader = async () => {
      // Everything that certainly doesn't fly starts swinging away now…
      const others = [...document.querySelectorAll<HTMLElement>(ITEMS)].filter(
        (el) => !candidates.some((c) => el === c || el.contains(c)),
      );
      const exits = swingAway(others, back);
      await load();

      // …and once the next page is known, pieces with a landing spot lift and
      // fly; pieces without one lose their name and swing away too.
      const landing = landingNames(event.newDocument, event.from);
      const fliers = candidates.filter((el) => landing.has(flightName(el)!));
      const stayers = candidates.filter((el) => !landing.has(flightName(el)!));
      stayers.forEach((el) => (el.style.viewTransitionName = 'none'));
      await Promise.all([...exits, ...swingAway(stayers, back), ...lift(fliers)]);
    };
  });

  document.addEventListener('astro:before-swap', (event) => {
    const doc = event.newDocument;
    // Astro copies <html> attributes from the incoming page, so set it there too.
    doc.documentElement.dataset.motion = document.documentElement.dataset.motion;

    // Names still active on the outgoing page: the only possible partners.
    const departing = new Set(
      flightCandidates()
        .map((el) => getComputedStyle(el).viewTransitionName)
        .filter((name) => name !== 'none'),
    );

    // Returning to a list: the card of the post we came from flies home.
    const fromId = postIdOf(event.from);
    if (fromId) nameCard(doc, fromId, departing);

    // A post page's pieces fly only if they have a partner; otherwise they
    // drop their name and feather in with everything else.
    doc.querySelectorAll<HTMLElement>('[data-flight]').forEach((el) => {
      if (departing.has(el.dataset.flight!)) el.classList.add('flying');
      else el.style.viewTransitionName = 'none';
    });
  });
</script>
